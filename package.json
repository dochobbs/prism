{
  "name": "prism",
  "productName": "Prism",
  "version": "0.1.0",
  "private": true,
  "description": "A local desktop workspace for comparing clinical evidence services",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "smoke": "electron . --smoke-test",
    "test:persistence": "node tests/persistence.cjs",
    "eval:synthesis": "node evals/run.cjs",
    "package": "electron-packager . 'Prism' --platform=darwin --arch=arm64 --app-bundle-id=md.hobbs.clinical-council --out=dist --overwrite --ignore='^/(tests|docs|evals|artifacts|\\.impeccable)(/|$)|^/DESIGN\\.md$'"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.2.0"
  },
  "dependencies": {
    "dompurify": "3.4.14",
    "marked": "18.0.11"
  }
}
